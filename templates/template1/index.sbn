<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ folder.title }}</title>
  <link rel="stylesheet" href="web/style.css">
</head>
<body>
  <header class="gallery-header">
    <h1>{{ folder.title }}</h1>
    {{ if folder.description }}<p class="folder-desc">{{ folder.description }}</p>{{ end }}
  </header>

  <!-- Stage: big current image with edge arrows revealed on cursor approach -->
  <main class="stage" id="stage">
    <button class="nav-arrow nav-prev" id="navPrev" aria-label="Previous">&#10094;</button>
    <figure class="stage-figure">
      <img class="stage-img" id="stageImg" alt="">
      <figcaption class="stage-caption" id="stageCaption"></figcaption>
    </figure>
    <button class="nav-arrow nav-next" id="navNext" aria-label="Next">&#10095;</button>
  </main>

  <!-- Bottom strip: scrollable thumbnails + folder tiles. Lazy-loads beyond initial count. -->
  <nav class="strip" id="strip" aria-label="Thumbnails">
    <div class="strip-track" id="stripTrack"></div>
  </nav>

  <footer class="gallery-footer">
    <span>{{ folder.name }}</span> &middot; <span>generated {{ generated_at }}</span>
  </footer>

  <script>window.__GALLERY__ = {{ data_json }};</script>
  <script src="web/gallery.js"></script>
</body>
</html>
